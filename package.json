{
  "name": "stillenough",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/version.mjs --check && tsc -b && vite build",
    "version:set": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint src eslint.config.js vite.config.ts vitest.config.ts",
    "test": "node --test scripts/version.test.mjs && vitest run --passWithNoTests",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  }
}
