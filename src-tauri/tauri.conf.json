{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StillEnough",
  "version": "../package.json",
  "identifier": "com.stillenough.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "localData": "$LOCALDATA/com.ai-plan-manager.app"
    },
    "windows": [
      {
        "label": "main",
        "title": "StillEnough",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
